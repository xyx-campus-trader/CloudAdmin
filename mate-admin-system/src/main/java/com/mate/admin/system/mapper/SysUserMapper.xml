<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mate.admin.system.mapper.SysUserMapper">

    <!-- 用户分页查询：LEFT JOIN 部门表取部门名称
         索引：idx_user_page (is_deleted, dept_id, status, create_time)
         WHERE is_deleted=0 [AND dept_id=? AND status=?] ORDER BY create_time DESC
         全部过滤列在索引前缀中，ORDER BY 直接走索引排序，无 filesort -->
    <select id="selectUserPage" resultType="com.mate.admin.system.entity.SysUser">
        SELECT u.*, d.name AS dept_name
        FROM sys_user u
        LEFT JOIN sys_dept d ON u.dept_id = d.id
        WHERE u.is_deleted = 0
        <if test="deptId != null">
            AND u.dept_id = #{deptId}
        </if>
        <if test="status != null">
            AND u.status = #{status}
        </if>
        ORDER BY u.create_time DESC
        LIMIT #{offset}, #{size}
    </select>

    <select id="selectUserCount" resultType="int">
        SELECT COUNT(*)
        FROM sys_user u
        WHERE u.is_deleted = 0
        <if test="deptId != null">
            AND u.dept_id = #{deptId}
        </if>
        <if test="status != null">
            AND u.status = #{status}
        </if>
    </select>
</mapper>
